@model ProductFormViewModel
@{
    ViewData["Title"] = L["Edit {0}", Model.Name];
}

<div class="row g-4">
    <div class="col-xl-8">
        <div class="panel">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <partial name="_Form" model="Model" />
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-clay">@L["Save changes"]</button>
                    <a class="btn btn-outline-dark" asp-action="Index">@L["Back to products"]</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="panel">
            <h2 class="panel-title">@L["Images"]</h2>
            @if (Model.Images.Count == 0)
            {
                <p class="text-muted">@L["No images yet. Upload JPG, PNG or WEBP files up to 5 MB."]</p>
            }
            <div class="image-manager">
                @foreach (var image in Model.Images)
                {
                    <div class="image-manager-item">
                        <img src="@Url.ProductImage(image.FileName)" alt="" />
                        @if (image.IsPrimary)
                        {
                            <span class="badge-soft badge-success">@L["Primary"]</span>
                        }
                        <div class="image-manager-actions">
                            @if (!image.IsPrimary)
                            {
                                <form asp-action="SetPrimaryImage" asp-route-id="@Model.Id" method="post">
                                    <input type="hidden" name="imageId" value="@image.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-dark">@L["Make primary"]</button>
                                </form>
                            }
                            <form asp-action="DeleteImage" asp-route-id="@Model.Id" method="post" onsubmit="return confirm(@L["Remove this image?"].JsString());">
                                <input type="hidden" name="imageId" value="@image.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["Remove"]</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
            <form asp-action="UploadImages" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="mt-3">
                <input type="file" name="files" class="form-control mb-2" accept=".jpg,.jpeg,.png,.webp" multiple required />
                <button type="submit" class="btn btn-dark w-100">@L["Upload images"]</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
