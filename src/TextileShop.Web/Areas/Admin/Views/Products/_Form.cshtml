@model ProductFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Sku" class="form-label"></label>
        <input asp-for="Sku" class="form-control" />
        <span asp-validation-for="Sku" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="0">@L["Select a category"]</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="WholesalePrice" class="form-label"></label>
        <input asp-for="WholesalePrice" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="WholesalePrice" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="StockQuantity" class="form-label"></label>
        <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
        <span asp-validation-for="StockQuantity" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MinimumWholesaleQuantity" class="form-label"></label>
        <input asp-for="MinimumWholesaleQuantity" class="form-control" type="number" min="1" />
        <span asp-validation-for="MinimumWholesaleQuantity" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Material" class="form-label"></label>
        <input asp-for="Material" class="form-control" />
        <span asp-validation-for="Material" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Size" class="form-label"></label>
        <input asp-for="Size" class="form-control" />
        <span asp-validation-for="Size" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" class="form-control" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>

<div class="col-12">
    <h2 class="h6 mt-2 mb-1">@L["Translations"]</h2>
    <p class="small text-muted mb-0">@L["Leave a field empty to show the English text in that language."]</p>
</div>
@for (var i = 0; i < Model.Translations.Count; i++)
{
    var language = SupportedLanguages.All.FirstOrDefault(candidate => candidate.Code == Model.Translations[i].Culture);
    <div class="col-12">
        <div class="border rounded p-3">
            <input type="hidden" asp-for="Translations[i].Culture" />
            <h3 class="h6">@(language?.NativeName ?? Model.Translations[i].Culture)</h3>
            <div class="mb-2">
                <label asp-for="Translations[i].Name" class="form-label">@L["Name"] (@language?.NativeName)</label>
                <input asp-for="Translations[i].Name" class="form-control" />
                <span asp-validation-for="Translations[i].Name" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <label asp-for="Translations[i].Description" class="form-label">@L["Description"] (@language?.NativeName)</label>
                <textarea asp-for="Translations[i].Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Translations[i].Description" class="text-danger"></span>
            </div>
            <div class="row g-2">
                <div class="col-md-4">
                    <label asp-for="Translations[i].Brand" class="form-label">@L["Brand"] (@language?.NativeName)</label>
                    <input asp-for="Translations[i].Brand" class="form-control" />
                    <span asp-validation-for="Translations[i].Brand" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Translations[i].Material" class="form-label">@L["Material"] (@language?.NativeName)</label>
                    <input asp-for="Translations[i].Material" class="form-control" />
                    <span asp-validation-for="Translations[i].Material" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Translations[i].Color" class="form-label">@L["Color"] (@language?.NativeName)</label>
                    <input asp-for="Translations[i].Color" class="form-control" />
                    <span asp-validation-for="Translations[i].Color" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Translations[i].Size" class="form-label">@L["Size"] (@language?.NativeName)</label>
                    <input asp-for="Translations[i].Size" class="form-control" />
                    <span asp-validation-for="Translations[i].Size" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
}
</div>
