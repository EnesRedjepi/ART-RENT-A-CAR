@model PagedResult<CustomerModel>
@{
    ViewData["Title"] = L["Customers"];
    var filter = (CustomerFilterViewModel)ViewBag.Filter;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4"><input name="search" value="@filter.Search" class="form-control" placeholder="@L["Search name or email"]" /></div>
    <div class="col-md-3">
        <select name="accountType" class="form-select">
            <option value="">@L["All account types"]</option>
            @foreach (var type in Enum.GetValues<AccountType>())
            {
                <option value="@type" selected="@(filter.AccountType == type)">@L[type.ToString()]</option>
            }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-dark" type="submit">@L["Filter"]</button></div>
</form>

<div class="panel p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>@L["Name"]</th><th>@L["Email"]</th><th>@L["Phone"]</th><th>@L["Registered"]</th><th>@L["Account type"]</th></tr></thead>
            <tbody>
                @foreach (var customer in Model.Items)
                {
                    <tr>
                        <td><strong>@customer.FullName</strong></td>
                        <td>@customer.Email</td>
                        <td>@customer.PhoneNumber</td>
                        <td>@customer.CreatedAt.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentUICulture)</td>
                        <td>
                            @if (customer.AccountType == AccountType.Administrator)
                            {
                                <span class="badge-soft badge-primary">@L["Administrator"]</span>
                            }
                            else
                            {
                                <form asp-action="ChangeAccountType" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@customer.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <select name="accountType" class="form-select form-select-sm account-type-select" aria-label="@L["Account type"]">
                                        <option value="@AccountType.Retail" selected="@(customer.AccountType == AccountType.Retail)">@L["Retail"]</option>
                                        <option value="@AccountType.Wholesale" selected="@(customer.AccountType == AccountType.Wholesale)">@L["Wholesale"]</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-dark">@L["Save"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="(Model.Page, Model.TotalPages)" />
