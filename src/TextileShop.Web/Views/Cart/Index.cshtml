@model CartModel
@{
    ViewData["Title"] = L["Shopping cart"];
    var isWholesaleCustomer = User.IsInRole(Roles.WholesaleCustomer);
}

<header class="catalog-hero cart-hero">
    <h1>@L["Shopping cart"]</h1>
    @if (!Model.IsEmpty)
    {
        <p class="mb-0">@L["Items"]: @Model.ItemCount</p>
    }
</header>

@if (Model.IsEmpty)
{
    <div class="empty-state cart-empty">
        <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
        <h2 class="h5">@L["Your cart is empty"]</h2>
        <p class="text-muted">@L["Browse our collection and add something you like."]</p>
        <a class="btn btn-clay btn-lg" asp-controller="Products" asp-action="Index">@L["Continue shopping"]</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            @foreach (var line in Model.Lines)
            {
                <div class="cart-line @(line.HasStockIssue ? "cart-line-issue" : "")">
                    <img src="@Url.ProductImage(line.ImageFileName)" alt="@line.ProductName" />
                    <div class="cart-line-info">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@line.ProductId" class="cart-line-name">@line.ProductName</a>
                        <div class="text-muted small">@L["SKU"] @line.Sku</div>
                        <div>
                            @line.UnitPrice.ToMoney()
                            @if (line.IsWholesalePrice)
                            {
                                <span class="badge-soft badge-success">@L["Wholesale price"]</span>
                            }
                            else if (isWholesaleCustomer)
                            {
                                <span class="small text-muted">@L["Order {0}+ for wholesale price", line.MinimumWholesaleQuantity]</span>
                            }
                        </div>
                        @if (!line.IsAvailable)
                        {
                            <div class="text-danger small">@L["This product is no longer available. Please remove it."]</div>
                        }
                        else if (line.Quantity > line.StockQuantity)
                        {
                            <div class="text-danger small">@L["Only {0} in stock. Please reduce the quantity.", line.StockQuantity]</div>
                        }
                    </div>
                    <div class="cart-line-quantity">
                        <form asp-action="Update" method="post" class="quantity-stepper">
                            <input type="hidden" name="productId" value="@line.ProductId" />
                            <button type="submit" name="quantity" value="@(line.Quantity - 1)" class="stepper-btn" aria-label="@L["Decrease quantity"]">&minus;</button>
                            <span aria-live="polite">@line.Quantity</span>
                            <button type="submit" name="quantity" value="@(line.Quantity + 1)" class="stepper-btn" aria-label="@L["Increase quantity"]" disabled="@(line.Quantity >= line.StockQuantity)">+</button>
                        </form>
                    </div>
                    <div class="cart-line-total">@line.LineTotal.ToMoney()</div>
                    <form asp-action="Remove" method="post" class="cart-line-remove">
                        <input type="hidden" name="productId" value="@line.ProductId" />
                        <button type="submit" class="remove-btn">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                            @L["Remove"]
                        </button>
                    </form>
                </div>
            }
            <a class="btn btn-outline-dark mt-3 continue-link" asp-controller="Products" asp-action="Index">&larr; @L["Continue shopping"]</a>
        </div>

        <div class="col-lg-4">
            <div class="summary-card">
                <h2 class="h5">@L["Order summary"]</h2>
                <div class="summary-row"><span>@L["Items"]</span><span>@Model.ItemCount</span></div>
                <div class="summary-row"><span>@L["Subtotal"]</span><span>@Model.Subtotal.ToMoney()</span></div>
                <div class="summary-row summary-total"><span>@L["Total"]</span><span>@Model.Total.ToMoney()</span></div>
                <partial name="_CurrencyNote" />
                <p class="summary-note">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="7" width="15" height="10" rx="1"/><path d="M16 10h4l3 3v4h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="19" cy="18" r="2"/></svg>
                    @L["Payment is collected on delivery."]
                </p>
                @if (Model.HasIssues)
                {
                    <button class="btn btn-clay btn-lg w-100" disabled>@L["Resolve stock issues to continue"]</button>
                }
                else
                {
                    <a class="btn btn-clay btn-lg w-100" asp-controller="Checkout" asp-action="Index">@L["Proceed to checkout"]</a>
                }
            </div>
        </div>
    </div>

    <div class="cart-sticky-bar">
        <div class="cart-sticky-total"><span>@L["Total"]</span><strong>@Model.Total.ToMoney()</strong></div>
        @if (Model.HasIssues)
        {
            <button class="btn btn-clay btn-lg" disabled>@L["Resolve stock issues to continue"]</button>
        }
        else
        {
            <a class="btn btn-clay btn-lg" asp-controller="Checkout" asp-action="Index">@L["Proceed to checkout"]</a>
        }
    </div>
}
