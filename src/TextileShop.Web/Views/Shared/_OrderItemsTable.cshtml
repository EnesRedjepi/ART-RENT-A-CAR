@model OrderDetails

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>@L["Product"]</th>
                <th class="sku-col">@L["SKU"]</th>
                <th class="text-end">@L["Unit price"]</th>
                <th class="text-end">@L["Quantity"]</th>
                <th class="text-end">@L["Total"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td class="text-muted sku-col">@item.Sku</td>
                    <td class="text-end">@item.UnitPrice.ToString("C")</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">@item.TotalPrice.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end total-label-wide">@L["Order total"]</th>
                <th colspan="3" class="text-end total-label-narrow">@L["Order total"]</th>
                <th class="text-end">@Model.TotalAmount.ToString("C")</th>
            </tr>
        </tfoot>
    </table>
</div>
