<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <link rel="icon" href="~/favicon.ico" sizes="any" /><link rel="icon" type="image/png" href="~/images/favicon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My Home</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/marketplace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/yns.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>
    <header class="site-header">
        <div class="container header-bar">
            <a class="navbar-brand header-brand" asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt="My Home" class="brand-logo" /></a>
            <nav class="header-nav collapse" id="mainNav" aria-label="@L["Shop all"]">
                <ul class="header-nav-list">
                    <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">@L["Shop all"]</a></li>
                    @await Component.InvokeAsync("CategoryMenu")
                    <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index" asp-route-sort="Newest">@L["New arrivals"]</a></li>
                </ul>
            </nav>
            <div class="header-tools">
                <form class="search-form" asp-controller="Products" asp-action="Index" method="get" role="search">
                    <input class="form-control" type="search" name="search" placeholder="@L["Search products"]" aria-label="@L["Search products"]" />
                    <button type="submit" class="search-submit" aria-label="@L["Search products"]">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                    </button>
                </form>
                <partial name="_LoginPartial" />
                <button type="button" class="theme-toggle" data-theme-toggle aria-label="@L["Toggle night mode"]" title="@L["Toggle night mode"]"><svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
                <partial name="_CurrencySwitcher" />
                <partial name="_LanguageSwitcher" model='"shop"' />
                <button class="header-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="@L["Toggle navigation"]">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                </button>
            </div>
        </div>
    </header>

    <main class="container py-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button></div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button></div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt="My Home" class="brand-logo" /></a>
                    <p>@L["Blankets, sofa covers, bed covers and home textiles for retail and wholesale."]</p>
                </div>
                <nav class="footer-col" aria-label="@L["Shop all"]">
                    <h2>@L["Shop all"]</h2>
                    <ul>
                        <li><a asp-controller="Products" asp-action="Index">@L["Shop the collection"]</a></li>
                        <li><a asp-controller="Products" asp-action="Index" asp-route-sort="Newest">@L["New arrivals"]</a></li>
                    </ul>
                </nav>
                <nav class="footer-col" aria-label="@L["My account"]">
                    <h2>@L["My account"]</h2>
                    <ul>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><a asp-controller="Account" asp-action="Profile">@L["Profile"]</a></li>
                            @if (!User.IsInRole(Roles.Administrator))
                            {
                                <li><a asp-controller="Orders" asp-action="Index">@L["My orders"]</a></li>
                            }
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="Login">@L["Log in"]</a></li>
                            <li><a asp-controller="Account" asp-action="Register">@L["Register"]</a></li>
                        }
                    </ul>
                </nav>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.UtcNow.Year My Home</span>
                <span>@L["Pay on delivery · Wholesale pricing for business customers"]</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
